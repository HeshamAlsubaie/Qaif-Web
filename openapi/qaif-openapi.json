{
  "openapi": "3.1.0",
  "info": {
    "title": "QAIF Case API",
    "description": "Layer-6 read-only API over an assembled forensic case. Read-only except a single audited endpoint that records a human's review decision on an AI suggestion (R6).",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "description": "Liveness \u2014 no database access.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}": {
      "get": {
        "tags": [
          "case"
        ],
        "summary": "Get Case",
        "description": "Case header + per-section counts.",
        "operationId": "get_case_cases__case_id__get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
